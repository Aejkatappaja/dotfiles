**/.DS_Store
/raycast

**/.claude/settings.local.json

gh/
gh-dash/
stripe/
neonctl/

herdr/*.log
herdr/session.json
herdr/.plugins.lock
hunk/state.json
themer/current

# local-only: screenshot geometry, tied to this machine's display
bin/shotmode

# local-only: pre-edit backups of theme snapshots
hunk/*.bak
opencode/themes/*.bak
yazi/*.bak
yazi/themes/*.bak

# build artifact: zipped from firefox-theme-sora/manifest.json
firefox-theme-sora/*.xpi

# only the wallpapers the theme confs reference stay in the repo, the rest is
# a local collection: it stays on disk, out of git
wallpapers/*
!wallpapers/tangerines.jpg
!wallpapers/stellar_sora.png
!wallpapers/current-theme.jpg

# local-only: zed backups, personal stash, prompt library db
zed/*_backup.json
zed/zed-stash/
zed/prompts/
